#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd "$script_dir/.." && pwd)"
tool="$project_root/lib/offbeat-count-translation.py"
split_root="$project_root/lib-translation"
state_path="$split_root/state.json"

if [ ! -f "$tool" ]; then
  echo "[offbeat-count-join-en] missing tool: $tool" >&2
  exit 1
fi

if [ ! -f "$state_path" ]; then
  echo "[offbeat-count-join-en] missing state file: $state_path" >&2
  exit 1
fi

output_path="$(python3 - "$state_path" <<'PY'
import json
import sys
from pathlib import Path

state = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
print(state["input_path"])
PY
)"

python3 "$tool" verify "$split_root"
python3 "$tool" join "$split_root" --output "$output_path" --side target
